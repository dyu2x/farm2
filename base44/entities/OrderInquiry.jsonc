{
  "name": "OrderInquiry",
  "type": "object",
  "properties": {
    "customer_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "size_preference": {
      "type": "string"
    },
    "quantity": {
      "type": "number",
      "default": 1
    },
    "message": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "closed"
      ],
      "default": "new"
    },
    "contacted_by": {
      "type": "string"
    },
    "contacted_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "customer_name",
    "email",
    "phone",
    "product_name",
    "quantity"
  ]
}